{
  "$schema": "https://typedoc.org/schema.json",
  "name": "Arman Danesh Portfolio — Documentation",
  "entryPoints": ["lib", "components"],
  "entryPointStrategy": "expand",
  "out": "docs",
  "readme": "README.md",
  "tsconfig": "tsconfig.json",
  "includeVersion": true,
  "excludePrivate": true,
  "excludeExternals": true,
  "excludeInternal": true,
  "skipErrorChecking": true,
  "hideGenerator": false,
  "searchInComments": true,
  "customCss": "./docs-theme.css",
  "customJs": "./docs-theme.js",
  "darkHighlightTheme": "github-dark",
  "lightHighlightTheme": "github-dark",
  "customFooterHtml": "<p><a href=\"https://my-resume.armandaneshwork.workers.dev/\" target=\"_blank\" rel=\"noopener\">Live resume</a> · <a href=\"https://arman-danesh.github.io/my-resume/\">docs</a> · <a href=\"https://github.com/arman-danesh/my-resume\" target=\"_blank\" rel=\"noopener\">GitHub</a></p>",
  "navigation": {
    "includeCategories": true,
    "includeGroups": true
  },
  "categorizeByGroup": true,
  "sort": ["source-order"],
  "plugin": [],
  "exclude": [
    "**/node_modules/**",
    "**/*.css",
    "**/out/**",
    "**/.next/**"
  ],
  "compilerOptions": {
    "skipLibCheck": true,
    "jsx": "react-jsx"
  }
}
